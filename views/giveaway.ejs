<% layout('layout') -%>
<div class="bg-white rounded-lg p-6 shadow">
  <h1 class="text-2xl font-bold"><%= g.title %></h1>
  <p class="text-gray-700 mt-2"><%= g.description %></p>
  <div class="mt-4 text-sm text-gray-500">Starts: <%= new Date(g.start_at).toLocaleString() %> • Ends: <%= g.end_at ? new Date(g.end_at).toLocaleString() : '—' %></div>

  <% if (g.end_at && now > g.end_at) { %>
    <div class="mt-4 p-3 bg-yellow-50 border-l-4 border-yellow-300">This giveaway has ended.</div>
  <% } %>

  <form class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-3" method="post" action="/giveaway/<%= g.id %>/join">
    <input name="name" placeholder="Your name" required class="p-2 border rounded" />
    <input name="contact" placeholder="Email or Phone" required class="p-2 border rounded" />
    <textarea name="note" placeholder="Note (optional)" class="p-2 border rounded md:col-span-2"></textarea>
    <button class="md:col-span-2 bg-indigo-600 text-white p-2 rounded">Join Giveaway</button>
  </form>

  <section class="mt-6">
    <h3 class="font-semibold">Participants (<%= participants.length %>)</h3>
    <ul class="mt-2 space-y-1 text-sm text-gray-700">
      <% participants.forEach(p => { %>
        <li><%= p.name %> — <%= p.contact %> • <%= new Date(p.created_at).toLocaleString() %></li>
      <% }) %>
    </ul>
  </section>

  <section class="mt-6">
    <h3 class="font-semibold">Winners</h3>
    <% if (winners.length) { %>
      <ul class="mt-2">
        <% winners.forEach(w => { %>
          <li><%= w.name %> • <%= new Date(w.created_at).toLocaleString() %></li>
        <% }) %>
      </ul>
    <% } else { %>
      <div class="text-sm text-gray-500">No winners yet.</div>
    <% } %>
  </section>
</div>
